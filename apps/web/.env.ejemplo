# Variables de apps/web (ver src/env.ts). Copiar a .env para desarrollo local.
# URL interna de la API (Go). En el VPS: http://127.0.0.1:4300
CAIGO_API=http://localhost:4300
# Clave publicable de Clerk (pk_live_… de Grupo Vimo). Vacía: /ingresar avisa que no está configurado.
PUBLIC_CLERK_PUBLICABLE=
PUBLIC_SITIO=http://localhost:5173
PUBLIC_PANEL=http://lugares.localhost:5173
# Estilo de MapLibre del registro de lugares. Vacía: teselas raster estándar de OpenStreetMap.
PUBLIC_MAPA_ESTILO=
# En producción: PORT=3500 HOST=127.0.0.1 ORIGIN no hace falta (dos hosts); ver README.
